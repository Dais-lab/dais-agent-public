# ===== Model Weights =====
# 사전훈련 / 학습된 모델 가중치 (.pth, 1GB+ 파일)
# MLflow Registry + MinIO 가 버전 관리. 호스트 파일 자체는 git 에 안 올림.
model/weights/

# ===== Model training 코드 (외부 보관) =====
# DINOv3 anomaly 학습/추론 응용 코드는 외부에 보관 (docs/EXTERNAL_CODE.md).
# 호스트의 본 경로를 채워야 ml-* 가 동작. git 추적 절대 금지.
model/dinov3_anomaly/

# ===== Claude (팀 공유) =====
# CLAUDE.md 와 .claude/rules/ 는 팀 공통 규칙 — git 추적함.
# 단, 개인 로컬 설정/캐시는 제외.
.claude/settings.local.json
.claude/cache/

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Docker compose 로컬 override =====
# 개발자별 커스텀 (docker compose 가 override.yml 을 자동 로드)
docker/docker-compose.override.yml
docker/docker-compose.*.local.yml

# ===== ML 학습 산출물 (DINOv3) =====
# 학습 체크포인트는 MLflow Registry + MinIO 가 진실의 원천
model/dinov3_anomaly/results/
model/dinov3_anomaly/output/

