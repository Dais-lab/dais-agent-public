# ============================================================
# dais_agent 환경변수 템플릿
# 사용법: cp .env.example .env  후  값 채우기
# 절대 .env 파일을 커밋하지 말 것
# ============================================================

# ===== PostgreSQL (MLflow / Airflow 공용 인스턴스, DB는 분리) =====
POSTGRES_USER=dais
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== MinIO (MLflow Artifact Storage, S3 호환) =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=mlflow-artifacts
MINIO_ENDPOINT_URL=http://minio:9000
# AWS_* 는 MLflow/boto3가 MinIO 접근 시 사용
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# ===== MLflow =====
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://dais:changeme@postgres:5432/mlflow_db
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts/

# ===== Airflow =====
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dais:changeme@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=changeme
AIRFLOW_UID=50000
# Airflow Web UI 관리자 계정 (airflow-init 컨테이너가 최초 1회 생성)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@dais.local

# ===== LLM (OpenAI 호환 endpoint — 별도 GPU 서버 또는 외부 API) =====
# ============================================================
# LLM — 쓰는 쪽 (Agent 컨테이너가 읽는 값)
# ============================================================
# Agent 는 dais_network 안에 있고 LLM 은 그 밖의 compose 프로젝트라, 호스트 포트를
# 한 바퀴 돌아 접속한다. LLM 이 같은 머신에 있어도 localhost 는 안 된다
# (컨테이너의 localhost 는 자기 자신) — 반드시 호스트 IP 를 쓸 것.
# ⚠️  아래 LLM_HOST_IP / LLM_HOST_PORT 와 값이 일치해야 한다.
LLM_BASE_URL=http://<GPU_SERVER_IP>:8010/v1
# 서빙 쪽 --served-model-name 의 모델 중립 alias. 모델을 바꿔도 이 값은 그대로.
LLM_MODEL=dais-llm
# 쓰는 쪽·띄우는 쪽이 공유하는 하나의 키. 인증(--api-key) 미사용이어도
# 빈 값이면 get_llm() 이 RuntimeError 를 내므로 더미 문자열을 채운다.
LLM_API_KEY=local

# ============================================================
# LLM — 띄우는 쪽 (docker/llm-qwen/deploy.sh 가 읽는 값)
# ============================================================
# 실행 위치. <context명>=개발 서버에서 원격 실행 / local=GPU 서버에서 직접 실행.
# context 미등록 시 1회:
#   docker context create server8 --docker "host=ssh://<user>@<GPU_SERVER_IP>:<ssh_port>"
LLM_DOCKER_CONTEXT=server8
# 원격 실행 시 필수 — health/verify 가 이 주소를 검사한다.
LLM_HOST_IP=
# 0.0.0.0=전체 / <내부망IP>=내부망 한정 / 127.0.0.1=SSH 터널 전용
# ⚠️  Agent 컨테이너에서 접속하려면 127.0.0.1 이면 안 된다 (호스트 밖에서 못 봄).
LLM_BIND_ADDR=0.0.0.0
# 8000 은 Agent API Gateway 예약 — LLM 은 8010 (docs/PORTS.md)
LLM_HOST_PORT=8010
# GPU 서버 호스트 기준 모델 캐시 경로 (컨테이너 내부 경로가 아님)
HF_CACHE_DIR=/home/<user>/.cache/huggingface

# 서빙할 모델 repo id. 4bit(AWQ/GPTQ) 권장 — 3090 은 FP8 불가(Ampere).
LLM_MODEL_ID=<huggingface repo id>

# 선점 VRAM = GPU 총량 × 이 비율. 가중치가 줄일 수 없는 바닥이고 남는 만큼이 KV 캐시다.
# 값은 GPU 총량과 "그 GPU 를 누구와 나눠 쓰는가"에 따라 달라진다.
# RTX 3090 24,576 MiB 실측 (2026-08-12): 0.45 / 16k / seqs 32 → 10,658 MiB 선점.
# 같은 GPU 에서 DINOv3 추론을 함께 돌린다면 올릴수록 그쪽이 CUDA OOM 에 가까워진다.
LLM_GPU_MEM_UTIL=0.45
# 모델 native 컨텍스트는 262144 이지만 KV 캐시가 감당하지 못한다.
# 낮출수록 같은 KV 로 동시 처리량이 늘어난다 — Agent 프롬프트는 16k 로 충분.
LLM_MAX_MODEL_LEN=16384
# 동시 처리 시퀀스 상한. vLLM 기본 1024 는 좁은 KV 예산에서 과하다.
LLM_MAX_NUM_SEQS=128
# VL 모델의 이미지 입력 허용 수. 0 이면 텍스트 전용(KV 캐시 절약)
LLM_MM_IMAGES=0
# up/recreate 전 요구하는 최소 여유 VRAM (MiB) = GPU 총량 × util + 여유.
# ⚠️  LLM_GPU_MEM_UTIL 을 바꾸면 이 값도 반드시 같이 바꾼다 (deploy.sh 가 기동 전 검사).
# 아래는 24GB GPU × util 0.45 기준. GPU 가 다르면 다시 계산할 것.
LLM_REQUIRED_FREE_MIB=11500

# 실측 확정값 (Qwen3-VL-8B-Instruct + vLLM v0.11.0).
# 모델·vLLM 버전을 바꾸면 './deploy.sh verify' 로 재검증. 대안: qwen3_coder, qwen3_xml
LLM_TOOL_PARSER=hermes
# 버전 고정. parser 동작이 버전에 따라 달라지므로 :latest 를 쓰지 않는다.
# ⚠️ VLLM_IMAGE 는 호스트 드라이버가 상한을 정한다.
#    v0.26.0 = CUDA 13.0 → 드라이버 580 이상 필요.
#    드라이버 570(CUDA 12.8) 서버에서는 v0.11.0 이 상한.
VLLM_IMAGE=vllm/vllm-openai:v0.26.0
# 비게이트 모델이라 보통 불필요
HUGGING_FACE_HUB_TOKEN=

# ===== LangSmith (Agent Tracing) =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dais_agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# 호스트 경로 (서버 환경별 — 외부 의존 자산)
#   - HOST_DINOV3_BACKBONE  : facebookresearch/dinov3 가 호스트에 clone 된 경로
#                             (컨테이너에 /opt/dinov3 로 read-only 마운트)
#   - HOST_DINOV3_PKG       : Model training 코드 (외부 보관) 의 호스트 경로
#                             다음 중 하나로 model/dinov3_anomaly/ 에 연결:
#                               a) ln -s ${HOST_DINOV3_PKG} model/dinov3_anomaly
#                               b) cp -r ${HOST_DINOV3_PKG}/* model/dinov3_anomaly/
#                             자세히는 docs/EXTERNAL_CODE.md 참고
# ============================================================
HOST_DINOV3_BACKBONE=/path/to/dinov3_backbone
HOST_DINOV3_PKG=/dais02/dinov3_anomaly
# ===== Web Backend (web/backend, FastAPI :8005) =====
# 웹 대시보드용 DB (Postgres init 스크립트가 생성). 자세한 스키마: docs/IMAGE_STORAGE_REPORT.md
DATA_DATABASE_URL=postgresql+asyncpg://dais:changeme@postgres:5432/dais_data_db
# 운영 이미지 전용 MinIO bucket (minio-init 이 자동 생성)
IMAGE_BUCKET=dais-images
# presigned URL 서명용 endpoint (브라우저에서 접근 가능한 외부 주소)
# 호스트에서만 접근하면 localhost:9000, 외부 노출 시 공인 IP:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
# CORS 허용 origin (쉼표 구분). 운영 시 실제 도메인/IP 로 교체
CORS_ORIGINS=http://localhost:5173,http://localhost:8005

# ===== ml-inference 연동 (웹 → 추론 API) =====
ML_INFERENCE_URL=http://ml-inference:8004
ML_INFERENCE_TIMEOUT_SEC=600
# 외부 서버 도달 실패 시 mock 결과 생성 (개발용)
ML_INFERENCE_MOCK_ON_FAILURE=true

# ===== Infra Agent (agents/infra_agent, :8002) =====
# 전부 기본값이 있어 미설정 시에도 동작한다. 바꿀 때만 적는다.
# 컨테이너 조회 경로. 미설정 시 컨테이너 상태·종료 원인·로그 수집만 비활성화되고
# 헬스체크·진단·알림은 그대로 동작한다. 소켓 직접 마운트 대신 프록시를 거친다.
DOCKER_API_BASE=http://docker-socket-proxy:2375
# 컨테이너 이름 접두사 (compose project 명)
INFRA_COMPOSE_PROJECT=dais
# 응답시간 시계열 조회처
INFRA_PROMETHEUS_BASE=http://prometheus:9090
# 응답시간이 평소 대비 이만큼 벌어지면 타임아웃 원인을 '지속 악화' 로 본다
INFRA_LATENCY_Z_ALERT=6
# 점검·LLM·메트릭 응답 대기 한도 (초)
INFRA_HTTP_TIMEOUT=5
INFRA_LLM_TIMEOUT=30
INFRA_LLM_RETRIES=1
INFRA_METRICS_TIMEOUT=10
# 진단에 넘길 로그 분량
INFRA_LOG_TAIL_LINES=50
INFRA_LOG_TAIL_CHARS=1200

# ===== Correction Agent RAG =====
# 전부 선택 사항이다. 비워두면 아래 기본값으로 동작한다.
# VectorDB 폴더 — chroma.sqlite3 + UUID 폴더 + doc_metadata.json 이 한 세트다.
# compose 는 볼륨(dais_correction_vectordb)을 /opt/dais/vectordb 로 마운트한다.
# ⚠️ rw 여야 한다. Chroma 는 조회만 해도 sqlite 에 쓰기를 시도한다.
VECTORDB_PATH=/opt/dais/vectordb
# GPU 를 쓰지 않는다. dais-llm 이 GPU 를 쓰고, 임베딩은 CPU 로 충분하다.
RAG_DEVICE=cpu
# 임베딩 모델 — 바꾸면 VectorDB 를 전부 다시 만들어야 한다(차원·좌표계가 달라진다).
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# 리랭커 — 한국어 파인튜닝본. 현장 표현 질의에서 원본 대비 크게 낫다.
RAG_RERANKER_MODEL=dragonkue/bge-reranker-v2-m3-ko
# 리랭커 신뢰도 하한. 최고점이 이 값 미만이면 재정렬을 버리고 1차 검색 순위를 쓴다.
RAG_RERANK_MIN_SCORE=0.1
# 모델 캐시(약 4.4GB). 볼륨으로 빼지 않으면 컨테이너를 띄울 때마다 다시 받는다.
HF_HOME=/opt/dais/hf-cache
